id_ed25519
id_rsa
authorized_keys

# yumed writes generated secrets (PQ keypair, real-facade html_secret) under
# ./.secrets when run from a working directory; never commit them.
.secrets/

# Local configs
config/*.local.json
config/*.secrets.json
config/*.private.json

# BaseFWX dependency checkout
basefwx/

# Python
__pycache__/
*.pyc

# Archives
*.zip
*.tar
*.tgz
*.txz
vendor/

# Debian / dpkg build outputs (cpack, dpkg-buildpackage leftovers)
*.deb
*.ddeb
*.buildinfo
*.changes
*.dsc
*.tar.xz
# The prebuilt vendor archive is deliberately NOT committed. It is published at
# https://deb.fixcraft.jp/yume/ and fetched only when --use-vendor is passed,
# verified against the SHA-256 and detached signature that DO live in
# third_party/prebuilt/. It was purged from history on 2026-07-24 (79 MB across
# 7 versions) because compiled objects embed builder paths that text
# sanitization cannot reach. There used to be a negation here re-including it;
# do not restore it.
*.tar.gz
*.tar.zst
*-dbgsym_*

# Cloudflare Wrangler dev cache
.wrangler/

# Build output artifacts (binaries, .app, .dmg) — never commit
bins/

# Local benchmark captures and reports
/yume-bench-results/
/yume-lan-kit/
# Agent notes must never be tracked. Root-anchored on purpose: an unanchored
# `AGENTS.md` would also swallow a legitimate one anywhere in the tree, and
# that filename is becoming a public convention. yume's own copy lives in
# .private/ai/ (already covered above); this is belt-and-braces for the root.
/AGENTS.md
/AI_NOTES.md

# Website build outputs. website/docs/*.md is regenerated from docs/*.md by
# .github/workflows/pages.yml on every deploy; a committed copy is stale by
# definition. website/docs/index.html is hand-written and stays tracked.
website/docs/*.md
website/docs/**/*.md
website/.jekyll-cache/
website/_site/

# Fuzzing working directories. tests/fuzz/run_fuzzers.sh writes seeds, an
# evolving corpus, logs and any crashing input here. A crashing input is
# evidence about a specific tree and belongs in the private overlay, never in
# Git. `fuzz-out` is the script's default and the name CI uses.
/fuzz-out/
/fuzz-*/
/build-fuzz/
