{
  "listen_port": 443,
  "transport_profile": "chrome151-node24-v1",
  "tls_cert": "/etc/ssl/fixcraft.crt",
  "tls_key": "/etc/ssl/fixcraft.key",
  "auth_keys": "/etc/yume/authorized_keys",
  "threads": 8,
  "max_sessions": 256,
  "bulk_key_max_sessions": 64,
  "security_mode": "extreme",
  "rekey_window": 8,
  "accept_rate_limit": 100,
  "egress_mbps": 0,
  "obfuscation": true,
  "obfs_secret_file": "/etc/yume/obfs.hex",
  "inner_psk_file": "/etc/yume/inner.hex",
  "real_backend": "loopback://127.0.0.1:3000"
}
