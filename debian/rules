#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DYUME_BUILD_NATIVE_APPLICATION=ON \
		-DYUME_BUILD_TRANSPORT_V2=OFF \
		-DYUME_USE_BASEFWX=OFF \
		-DYUME_USE_BUNDLED_NLOHMANN=OFF \
		-DYUME_NATIVE_OPT=OFF \
		-DYUME_LTO=OFF \
		-DYUME_STATIC_OPENSSL=OFF \
		-DYUME_DEB_SHLIBDEPS=ON \
		-DYUME_BUILD_SHARED_ABI=OFF \
		-DYUME_INSTALL_EXPERIMENTAL_SDK=OFF \
		-DYUME_BUILD_GUI=OFF

override_dh_installsystemd:
	dh_installsystemd -p yume-daemon --name=yumed --no-enable --no-start
	dh_installsystemd --remaining-packages
