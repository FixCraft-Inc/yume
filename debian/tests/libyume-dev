#!/bin/sh
set -eu

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
prefix="${YUME_TEST_PREFIX:-/usr}"
multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
sanitizer_flags="${YUME_TEST_SANITIZER_FLAGS:-}"

if [ "$prefix" != "/usr" ]; then
    unset PKG_CONFIG_PATH
    export PKG_CONFIG_LIBDIR="${prefix}/lib/${multiarch}/pkgconfig:${prefix}/lib/pkgconfig"
    export LD_LIBRARY_PATH="${prefix}/lib/${multiarch}:${prefix}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

cat >"$tmp/check.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <yume/yume.h>

int main(void) {
    yume_build_info info;
    int rc = yume_get_build_info(&info, sizeof(info));
    if (rc != YUME_STATUS_OK) {
        return 1;
    }
    if (yume_abi_version() != YUME_ABI_VERSION || info.abi_version != YUME_ABI_VERSION) {
        return 2;
    }
    if (info.struct_size != sizeof(info)) {
        return 3;
    }
    if (!info.yume_version || !info.basefwx_version || !info.pq_backend || !info.argon2_backend) {
        return 4;
    }
    if ((info.feature_flags & YUME_FEATURE_PBKDF2_HKDF) == 0 ||
        (info.feature_flags & YUME_FEATURE_PACKET_BULK) == 0 ||
        (info.feature_flags & YUME_FEATURE_PQ_MLKEM1024) == 0) {
        return 5;
    }
    if (!yume_strerror(YUME_STATUS_NOT_RUNNING)) {
        return 6;
    }
    yume_client *client = yume_client_create();
    yume_server *server = yume_server_create();
    if (!client || !server) {
        yume_client_destroy(client);
        yume_server_destroy(server);
        return 7;
    }
    char tiny[1];
    size_t needed = 0;
    if (yume_client_status_json(client, tiny, sizeof(tiny), &needed) != YUME_STATUS_BUFFER_TOO_SMALL ||
        needed <= sizeof(tiny)) {
        yume_client_destroy(client);
        yume_server_destroy(server);
        return 8;
    }
    if (yume_server_register_service(server, "example-service-v1") != YUME_STATUS_NOT_RUNNING) {
        yume_client_destroy(client);
        yume_server_destroy(server);
        return 9;
    }
    if (yume_stream_peer_json(NULL, tiny, sizeof(tiny), &needed) != YUME_STATUS_INVALID_ARGUMENT) {
        yume_client_destroy(client);
        yume_server_destroy(server);
        return 10;
    }
    yume_packet *packet = NULL;
    if (yume_client_open_packet(client, 0, &packet) != YUME_STATUS_WOULD_BLOCK || packet != NULL) {
        yume_client_destroy(client);
        yume_server_destroy(server);
        return 11;
    }
    yume_client_destroy(client);
    yume_server_destroy(server);
    printf("yume abi %u, yume %s, basefwx %s\n",
           info.abi_version,
           info.yume_version,
           info.basefwx_version);
    return 0;
}
EOF

# Word splitting is intentional: the CMake test passes compiler-driver flags,
# never user input. Sanitized libyume builds require the same runtime on the
# external consumer's link line so ASan is loaded before libyume.
# shellcheck disable=SC2086
cc $sanitizer_flags $(pkg-config --cflags yume) "$tmp/check.c" \
    $(pkg-config --libs yume) -o "$tmp/check-pkg-config"
"$tmp/check-pkg-config"

mkdir "$tmp/cmake"
cat >"$tmp/cmake/CMakeLists.txt" <<'EOF'
cmake_minimum_required(VERSION 3.20)
project(yume_abi_consumer C)
find_package(yume CONFIG REQUIRED)
add_executable(check-cmake ../check.c)
target_link_libraries(check-cmake PRIVATE yume::yume)
EOF

cmake -S "$tmp/cmake" -B "$tmp/cmake-build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="$sanitizer_flags" \
    -DCMAKE_PREFIX_PATH="$prefix"
cmake --build "$tmp/cmake-build"
"$tmp/cmake-build/check-cmake"

lib="${prefix}/lib/${multiarch}/libyume.so.1"
if [ ! -e "$lib" ]; then
    lib="${prefix}/lib/libyume.so.1"
fi
test -e "$lib"

header="${prefix}/include/yume/yume.h"
test -f "$header"
sed -n \
    's/^YUME_API[^(]*[ *]\(yume_[A-Za-z0-9_]*\)[[:space:]]*(.*/\1/p' \
    "$header" | sort -u >"$tmp/expected-symbols"
test "$(wc -l <"$tmp/expected-symbols")" -gt 0

nm -D --defined-only "$lib" | awk '{print $3}' | sort >"$tmp/actual-symbols"
diff -u "$tmp/expected-symbols" "$tmp/actual-symbols"
