#!/bin/sh
set -eu

test -x /usr/bin/yume
test -x /usr/bin/yumed
test -r /usr/lib/sysusers.d/yume-daemon.conf
getent passwd yume | grep -Eq '^yume:[^:]*:[0-9]+:[0-9]+:YUME server daemon:/var/lib/yume:/usr/sbin/nologin$'

architecture=$(dpkg --print-architecture)
openssl_version=$(dpkg-query -W -f='${Version}' "libssl3t64:$architecture")
for package in yume yume-daemon; do
    dpkg-query -W -f='${Depends}\n' "$package" | grep -F "libssl3t64 (= $openssl_version)"
done

yume --version | grep -F "transport YTP/1, config schema 1"
yumed --version | grep -F "transport YTP/1, config schema 1"
yume-setup --help >/dev/null
yume-doctor --help >/dev/null

man -w yume >/dev/null
man -w yumed >/dev/null
man -w yume-setup >/dev/null
man -w yume-doctor >/dev/null

test -r /etc/yume/yumed.json
grep -Eq '"schema": *1,' /etc/yume/yumed.json
grep -Eq '"role": *"server"' /etc/yume/yumed.json
# Bootstrap ships no credentials and must never authorize a listener.
if yumed --config /etc/yume/yumed.json --validate; then
    echo "Unprovisioned daemon configuration unexpectedly passed validation" >&2
    exit 1
fi
test -r /usr/lib/systemd/system/yumed.service || test -r /lib/systemd/system/yumed.service
