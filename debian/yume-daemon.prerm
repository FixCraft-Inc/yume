#!/bin/sh
set -e

# Template instances are managed individually by systemd. Stop the sockets
# with their services so removal cannot activate another module instance.
if [ "$1" = remove ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop yumed.service 'yume-module@*.socket' 'yume-module@*.service'
fi

#DEBHELPER#
