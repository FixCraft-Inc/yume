[Unit]
Description=YUME module %i socket
Documentation=man:yumed(8)
Documentation=file:/usr/share/doc/yume-daemon/README.Debian

[Socket]
# yumed connects here for each authorized stream of service %i. Only the
# yume user can connect, which is what makes the stream's identity header
# trustworthy, and the module receives the socket as descriptor 3.
ListenStream=/run/yume-modules/%i.sock
SocketUser=yume
SocketGroup=yume
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
