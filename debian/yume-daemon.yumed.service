[Unit]
Description=YUME server daemon
Documentation=man:yumed(8)
Documentation=file:/usr/share/doc/yume-daemon/README.Debian
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/yume/yumed.json
ConditionPathExists=/etc/yume/credentials/server-composite.pem
ConditionPathExists=/etc/yume/credentials/authorized-keys.json
ConditionPathExists=/etc/yume/credentials/admin-keys.json
ConditionPathExists=/etc/yume/credentials/server-tls.pem
ConditionPathExists=/etc/yume/credentials/server-tls.key.pem
ConditionPathExists=/etc/yume/credentials/admission.key
ConditionPathExists=/etc/yume/credentials/server-mlkem.key.pem
ConditionPathIsDirectory=/etc/yume/cover-site

[Service]
Type=simple
User=yume
Group=yume
ExecStartPre=/usr/bin/yumed --config /etc/yume/yumed.json --validate
ExecStart=/usr/bin/yumed --config /etc/yume/yumed.json
# Reload re-reads the credential stores. Validate them first so a broken
# edit is reported by systemctl instead of only in the daemon log.
ExecReload=/usr/bin/yumed --config /etc/yume/yumed.json --validate
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
UMask=0077
LimitNOFILE=65536

# Add deployment-specific hard process ceilings with `systemctl edit yumed`.
# Examples: CPUQuota=800% (eight logical CPUs), MemoryHigh=768M,
# MemoryMax=1G. Universal package defaults would be unsafe across hosts.

# Port 443 support without running the daemon as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Keep the daemon confined to its configuration, state, and log paths.
RuntimeDirectory=yume
StateDirectory=yume
LogsDirectory=yume
ReadOnlyPaths=/etc/yume
ReadWritePaths=/run/yume /var/lib/yume /var/log/yume
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
