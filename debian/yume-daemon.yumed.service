[Unit]
Description=YUME server daemon
Documentation=man:yumed(8)
Documentation=file:/usr/share/doc/yume-daemon/README.Debian
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/yume/yumed.json
ConditionPathExists=/etc/yume/server.crt
ConditionPathExists=/etc/yume/server.key
ConditionPathExists=/etc/yume/authorized_keys
ConditionPathExists=/etc/yume/obfs.hex
ConditionPathExists=/etc/yume/inner.hex

[Service]
Type=simple
User=yume
Group=yume
ExecStart=/usr/bin/yumed --config /etc/yume/yumed.json
Restart=on-failure
RestartSec=5s
UMask=0077
LimitNOFILE=65536

# Add deployment-specific hard process ceilings with `systemctl edit yumed`.
# Examples: CPUQuota=800% (eight logical CPUs), MemoryHigh=768M,
# MemoryMax=1G. Universal package defaults would be unsafe across hosts.

# Port 443 support without running the daemon as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Keep the daemon confined to its configuration, state, and log paths.
RuntimeDirectory=yume
StateDirectory=yume
LogsDirectory=yume
ReadOnlyPaths=/etc/yume
ReadWritePaths=/run/yume /var/lib/yume /var/log/yume
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
