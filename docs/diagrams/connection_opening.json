{
  "name": "connection_opening",
  "type": "sequence",
  "title": "How a YUME connection opens",
  "summary": "yume loads the cover site like a browser, proves it holds the admission key, and only then runs YTP/1 authentication inside the carrier.",
  "comment": [
    "Checked against src/stealth/h2_carrier.cpp (priming, extended CONNECT, 200),",
    "src/providers/h2_web_front_door.cpp (proof, nonce reservation, cover answer)",
    "and src/engine/session_engine.cpp (AUTH flights and CAPABILITIES order)."
  ],
  "targets": {
    "web": true
  },
  "nodes": [
    {
      "id": "yume",
      "kind": "client",
      "title": "yume",
      "sub": "client",
      "note": "Dials the server and opens it the way the pinned Chrome release would, then proves it holds the admission key before YTP/1 starts.",
      "source": [
        "src/runtime/native_client_runtime.cpp",
        "src/providers/h2_duplex_carrier.cpp",
        "src/stealth/h2_carrier.cpp"
      ]
    },
    {
      "id": "yumed",
      "kind": "server",
      "title": "yumed",
      "sub": "server",
      "note": "Its front door answers every request without a valid proof from the static site, and turns at most one stream per TLS connection into the carrier.",
      "source": [
        "src/runtime/native_server_runtime.cpp",
        "src/providers/h2_web_front_door.cpp",
        "src/providers/cover_site.cpp"
      ]
    }
  ],
  "edges": [
    {
      "from": "yume",
      "to": "yumed",
      "label": "TLS 1.3, Chrome ClientHello, h2"
    },
    {
      "from": "yume",
      "to": "yumed",
      "label": "GET the cover page and its assets"
    },
    {
      "from": "yumed",
      "to": "yume",
      "label": "the static site answers"
    },
    {
      "from": "yume",
      "to": "yumed",
      "label": "CONNECT websocket with the proof"
    },
    {
      "from": "yumed",
      "to": "yumed",
      "label": "check proof, reserve its nonce"
    },
    {
      "from": "yumed",
      "to": "yume",
      "label": "200: this stream is the carrier"
    },
    {
      "from": "yumed",
      "to": "yume",
      "label": "AUTH challenge: identity, keys",
      "channel": "tunnel"
    },
    {
      "from": "yume",
      "to": "yumed",
      "label": "AUTH response: PSK proof, keys",
      "channel": "tunnel"
    },
    {
      "from": "yumed",
      "to": "yume",
      "label": "AUTH_RESULT: accepted",
      "channel": "tunnel"
    },
    {
      "from": "yumed",
      "to": "yume",
      "label": "CAPABILITIES, sealed from here",
      "channel": "tunnel"
    },
    {
      "from": "yume",
      "to": "yumed",
      "label": "CAPABILITIES, sealed",
      "channel": "tunnel"
    },
    {
      "from": "yume",
      "to": "yumed",
      "label": "OPEN a service, then DATA",
      "channel": "tunnel"
    }
  ]
}
