{
  "name": "relay_route",
  "type": "route",
  "title": "Direct federated relay path",
  "summary": "YRR2 payload protection runs endpoint to endpoint while federation uses one direct server link and never selects an exit.",
  "comment": [
    "One direct server link. There is no third-node transit and no federated exit."
  ],
  "targets": {
    "web": true
  },
  "nodes": [
    {
      "id": "peer_app_a",
      "kind": "app",
      "title": "PEER APP A",
      "sub": "chat / file / bytes"
    },
    {
      "id": "yume_client_a",
      "kind": "client",
      "title": "YUME CLIENT A",
      "sub": "relay-v2 initiator"
    },
    {
      "id": "yumed_a",
      "kind": "server",
      "title": "YUMED A",
      "sub": "direct federation peer"
    },
    {
      "id": "yumed_b",
      "kind": "server",
      "title": "YUMED B",
      "sub": "one hop, no exit or transit"
    },
    {
      "id": "yume_client_b",
      "kind": "client",
      "title": "YUME CLIENT B",
      "sub": "relay-v2 responder"
    },
    {
      "id": "peer_app_b",
      "kind": "app",
      "title": "PEER APP B",
      "sub": "chat / file / bytes"
    }
  ],
  "edges": [
    {
      "from": "peer_app_a",
      "to": "yume_client_a",
      "label": "local request"
    },
    {
      "from": "yume_client_a",
      "to": "yumed_a",
      "label": "TLS / H2 / YRR2"
    },
    {
      "from": "yumed_a",
      "to": "yumed_b",
      "label": "direct federation link"
    },
    {
      "from": "yumed_b",
      "to": "yume_client_b",
      "label": "TLS / H2 / YRR2"
    },
    {
      "from": "yume_client_b",
      "to": "peer_app_b",
      "label": "local delivery"
    }
  ]
}
