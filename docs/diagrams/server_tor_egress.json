{
  "name": "server_tor_egress",
  "type": "route",
  "title": "Server-side Tor egress",
  "summary": "yumed hands the target stream to its local Tor, so the target sees a Tor exit rather than the server address.",
  "targets": {
    "web": true
  },
  "nodes": [
    {
      "id": "human_app",
      "kind": "app",
      "title": "HUMAN APP",
      "sub": "normal app"
    },
    {
      "id": "yume_client",
      "kind": "client",
      "title": "YUME CLIENT",
      "sub": "YUME carrier"
    },
    {
      "id": "yumed_server",
      "kind": "server",
      "title": "YUMED SERVER",
      "sub": "receives target request"
    },
    {
      "id": "server_tor",
      "kind": "tor",
      "title": "SERVER TOR",
      "sub": "SOCKS / transparent route"
    },
    {
      "id": "tor_entry",
      "kind": "tor",
      "title": "TOR ENTRY",
      "sub": "obfs4 bridge or guard",
      "group": "TOR CIRCUIT"
    },
    {
      "id": "tor_middle",
      "kind": "tor",
      "title": "TOR MIDDLE",
      "sub": "relay nodes",
      "group": "TOR CIRCUIT"
    },
    {
      "id": "tor_exit",
      "kind": "tor",
      "title": "TOR EXIT",
      "sub": "target sees this IP",
      "group": "TOR CIRCUIT"
    },
    {
      "id": "target_site",
      "kind": "target",
      "title": "TARGET SITE",
      "sub": "website / API"
    }
  ],
  "edges": [
    {
      "from": "human_app",
      "to": "yume_client"
    },
    {
      "from": "yume_client",
      "to": "yumed_server",
      "channel": "tunnel"
    },
    {
      "from": "yumed_server",
      "to": "server_tor"
    },
    {
      "from": "server_tor",
      "to": "tor_entry",
      "channel": "onion"
    },
    {
      "from": "tor_entry",
      "to": "tor_middle"
    },
    {
      "from": "tor_middle",
      "to": "tor_exit"
    },
    {
      "from": "tor_exit",
      "to": "target_site"
    }
  ]
}
