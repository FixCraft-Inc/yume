{
  "name": "tor_yume_tor",
  "type": "route",
  "title": "Tor to YUME to Tor",
  "summary": "Tor on both sides of the YUME carrier, so neither edge sees both the real client and the final target.",
  "targets": {
    "man": [
      "docs/man/yume.1"
    ],
    "web": true
  },
  "nodes": [
    {
      "id": "human_app",
      "kind": "app",
      "title": "HUMAN APP",
      "sub": "normal app"
    },
    {
      "id": "yume_client",
      "kind": "client",
      "title": "YUME CLIENT",
      "sub": "carrier source"
    },
    {
      "id": "client_tor",
      "kind": "tor",
      "title": "CLIENT TOR",
      "sub": "obfs4 optional"
    },
    {
      "id": "tor_exit_a",
      "kind": "tor",
      "title": "TOR EXIT A",
      "sub": "client-side edge"
    },
    {
      "id": "yumed_server",
      "kind": "server",
      "title": "YUMED SERVER",
      "sub": "sees Tor exit A"
    },
    {
      "id": "server_tor",
      "kind": "tor",
      "title": "SERVER TOR",
      "sub": "obfs4 optional"
    },
    {
      "id": "tor_exit_b",
      "kind": "tor",
      "title": "TOR EXIT B",
      "sub": "target-side edge"
    },
    {
      "id": "target_site",
      "kind": "target",
      "title": "TARGET SITE",
      "sub": "sees exit B"
    }
  ],
  "edges": [
    {
      "from": "human_app",
      "to": "yume_client"
    },
    {
      "from": "yume_client",
      "to": "client_tor",
      "label": "YUME carrier through client Tor"
    },
    {
      "from": "client_tor",
      "to": "tor_exit_a"
    },
    {
      "from": "tor_exit_a",
      "to": "yumed_server",
      "label": "YUME carrier reaches server"
    },
    {
      "from": "yumed_server",
      "to": "server_tor",
      "label": "target stream through server Tor"
    },
    {
      "from": "server_tor",
      "to": "tor_exit_b"
    },
    {
      "from": "tor_exit_b",
      "to": "target_site"
    }
  ]
}
