{
  "name": "yume_over_tor",
  "type": "route",
  "title": "YUME over Tor",
  "summary": "The YUME carrier itself travels through client-side Tor, so yumed sees a Tor exit instead of the client address.",
  "targets": {
    "web": true
  },
  "nodes": [
    {
      "id": "human_app",
      "kind": "app",
      "title": "HUMAN APP",
      "sub": "normal app"
    },
    {
      "id": "yume_client",
      "kind": "client",
      "title": "YUME CLIENT",
      "sub": "carrier source"
    },
    {
      "id": "client_tor",
      "kind": "tor",
      "title": "CLIENT TOR",
      "sub": "carries YUME carrier",
      "group": "CLIENT-SIDE TOR"
    },
    {
      "id": "tor_exit",
      "kind": "tor",
      "title": "TOR EXIT",
      "sub": "client-side edge",
      "group": "CLIENT-SIDE TOR"
    },
    {
      "id": "yumed_server",
      "kind": "server",
      "title": "YUMED SERVER",
      "sub": "sees Tor exit"
    },
    {
      "id": "target_site",
      "kind": "target",
      "title": "TARGET SITE",
      "sub": "sees server IP"
    }
  ],
  "edges": [
    {
      "from": "human_app",
      "to": "yume_client"
    },
    {
      "from": "yume_client",
      "to": "client_tor"
    },
    {
      "from": "client_tor",
      "to": "tor_exit",
      "channel": "onion"
    },
    {
      "from": "tor_exit",
      "to": "yumed_server"
    },
    {
      "from": "yumed_server",
      "to": "target_site"
    }
  ]
}
