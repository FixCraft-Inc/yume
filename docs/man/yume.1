.TH YUME 1 "2026-08-01" "YUME 2.0-dev6" "YUME Manual"
.SH NAME
yume \- stealth post-quantum transport client
.SH SYNOPSIS
.B yume
.B --server
.I host
.B -i
.I identity_composite
[
.I mode
]
[
.I options
]
.PP
.B yume
.B --config
.I path
[
.I mode
]
