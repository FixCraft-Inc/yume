--

@section Security
--obfs-secret-file
--inner-psk-file
@note
  The inner suite and per-frame keys are mandatory. JSON security_mode
  selects extreme (default), normal, soft, or bounded ultimate epoch
  limits; see docs/SECURITY_MODES.md. There is no 1.x downgrade.
@end
--require-operator-identity
--operator-ca-cert
--accept-monitoring
@note
  This proof identifies the CA-authorized operator; it cannot prove that
  the operator does not inspect or log traffic.
@end
--tls-ca
--tls-pin

@section Proxy
--proxy
--tor
--no-proxy

@section TLS
--tls-name
--profile
--transport-profile
--tls-backend
--tls-helper
--tls-fingerprint-log
--tls-fingerprint-log-path
--tls-fingerprint-verify
--tls-fingerprint-test-endpoint
--self-dpi
--no-self-dpi

@section Console
@note
  help, status, directory, invites, chat, send, send-file, send-bytes,
  accept, reject, history, history-delete, admin attach, admin status,
  admin sessions, admin stop, whoami, quit
@end

@section Share files (server backup / device migration)
export
import
@gap
--password-stdin

@section Other
@note
  completion bash
@end
--completion
-h
--version
--credits
