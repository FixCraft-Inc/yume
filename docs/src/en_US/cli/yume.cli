--json-stdout
--keep-workdir
--dev
--no-color
--color
--bench
--bench-full
--bench-mib
--bench-chunk-kib
--bench-streams
--bench-direction
--outer-carrier-evidence
-L
--lport
-R
--run
--proxycmd
--exec
--allow-exec
--control
--id
