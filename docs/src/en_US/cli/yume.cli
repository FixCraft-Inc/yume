#!yume-cli 1
binary:    yume
manual:    yume_1
output:    src/client/cli/display/help_text.hpp
namespace: yume::client::cli
---
@usage
yume --server <host> -i <id_ed25519> [mode] [options]
yume completion bash
yume --help
yume --version
yume --credits
@end

@section Connection
--server
--cluster
--hide-in-the-crowd
--config
--save-server
-i
--secondary-auth
--admin-auth

@section Modes
--socks
--packet-tun
--monero-rpc
--monero-rpc-listen
--codec
