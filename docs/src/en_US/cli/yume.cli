#!yume-cli 1
binary:    yume
manual:    yume_1
output:    src/runtime/yume_help_text.hpp
namespace: yume::runtime::yume_cli
output-kind: static-help
---
@usage
yume --config <path> [--validate] [run settings] [evidence]
yume --config <path> --status
yume --config <path> --accept-route <id>
yume --seal-kit <directory> --output <file>
yume --import-kit <file> --into <directory>
yume --version
yume --completion bash
yume --help
@end

@section Options
--config
--validate
--status
--accept-route
--version
--completion
-h

@section Run settings
--connect
--socks-address
--socks-port

@section Kits
--seal-kit
--output
--import-kit
--into

@section Evidence
--outer-carrier-evidence

@gap
@note
Security policy comes only from the schema-1 configuration.
This development runtime is not qualified for production use.
@end
