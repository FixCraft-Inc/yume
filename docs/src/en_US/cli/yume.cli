#!yume-cli 1
binary:    yume
manual:    yume_1
output:    src/runtime/yume_help_text.hpp
namespace: yume::runtime::yume_cli
output-kind: static-help
---
@usage
yume --config <path> [--validate] [run settings] [evidence]
yume --version
yume --help
@end

@section Options
--config
--validate
--version
-h

@section Run settings
--connect
--socks-address
--socks-port

@section Evidence
--outer-carrier-evidence

@gap
@note
Security policy comes only from the schema-1 configuration.
This development runtime is not qualified for production use.
@end
