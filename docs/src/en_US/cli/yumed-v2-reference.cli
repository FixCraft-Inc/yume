#!yume-cli 1
binary:    yumed-v2-reference
manual:    yumed_v2_reference_8
output:    src/server/cli/help_text.hpp
namespace: yume::server::cli
---
@usage
yumed-v2-reference [--config <path>] [options]
yumed-v2-reference completion bash
yumed-v2-reference --completion bash
yumed-v2-reference --help
yumed-v2-reference --version
yumed-v2-reference --credits
@end

@note
  Transport-v2 reference build; use its transport-v2 configuration.
@end

