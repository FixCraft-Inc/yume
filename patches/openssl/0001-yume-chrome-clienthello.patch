+ * YUME's Chrome-shaped ClientHello is an opt-in downstream extension. The
+ * option is deliberately outside SSL_OP_ALL so an ordinary SSL_CTX remains
+ * byte-for-byte compatible with upstream OpenSSL.
+ */
+#define SSL_OP_YUME_CHROME_CLIENT_HELLO SSL_OP_BIT(36)
+
+/*
@@ -1345,0 +1353 @@
+#define SSL_CTRL_YUME_CHROME_CLIENT_HELLO 0x5943
@@ -1364,0 +1373,2 @@
+#define SSL_CTX_set_yume_chrome_client_hello(ctx, onoff) \
+    SSL_CTX_ctrl(ctx, SSL_CTRL_YUME_CHROME_CLIENT_HELLO, onoff, NULL)
