{
  "schema": 1,
  "role": "server",
  "endpoint": {
    "listen_addresses": [
      "0.0.0.0",
      "::"
    ],
    "port": 443,
    "event_loops": 1
  },
  "suite": {
    "id": "ytp1-tls13-h2",
    "secure_channel": "tls13-native",
    "front_door": "h2-web",
    "carrier": "h2-duplex",
    "session": "ytp1-hybrid"
  },
  "credentials": {
    "composite_key": {
      "file": "credentials/server-composite.pem"
    },
    "authorized_keys": {
      "file": "credentials/authorized-keys.json"
    },
    "admin_keys": {
      "file": "credentials/admin-keys.json"
    },
    "tls_certificate": {
      "file": "credentials/server-tls.pem"
    },
    "tls_key": {
      "file": "credentials/server-tls.key"
    },
    "admission_key": {
      "file": "credentials/admission.key"
    },
    "mlkem_key": {
      "file": "credentials/server-mlkem.key"
    }
  },
  "cover": {
    "profile": "chrome151-node24-v1",
    "root": {
      "file": "cover-site"
    }
  },
  "services": [
    {
      "name": "tcp",
      "kind": "stream",
      "max_concurrent_streams": 256
    },
    {
      "name": "udp",
      "kind": "packet",
      "max_concurrent_streams": 256
    },
    {
      "name": "packet",
      "kind": "packet",
      "max_concurrent_streams": 16
    },
    {
      "name": "chat.echo",
      "kind": "stream",
      "max_concurrent_streams": 8
    }
  ],
  "adapters": [
    {
      "kind": "direct_tcp",
      "service": "tcp",
      "destinations": {
        "public": true,
        "networks": [
          "10.0.0.0/8",
          "fd00::/8"
        ],
        "lists": [
          {
            "action": "deny",
            "format": "json",
            "file": "lists/deny.json"
          },
          {
            "action": "allow",
            "format": "vpdb",
            "file": "lists/vpn.vpdb"
          }
        ],
        "country_database": {
          "file": "lists/GeoLite2-Country.mmdb"
        }
      }
    },
    {
      "kind": "direct_udp",
      "service": "udp",
      "destinations": {
        "public": false,
        "networks": [
          "192.0.2.0/24"
        ]
      }
    },
    {
      "kind": "module",
      "service": "chat.echo",
      "program": "/usr/lib/yume/modules/yume-echo-module",
      "arguments": [
        "--quiet"
      ]
    },
    {
      "kind": "packet",
      "service": "packet",
      "interface_name": "yume0",
      "mtu": 1420,
      "network": {
        "addresses": [
          "10.71.0.1/32"
        ],
        "routes": [
          "10.71.0.2/32"
        ],
        "local_networks": [
          "10.71.0.1/32"
        ],
        "peer_networks": [
          "10.71.0.2/32"
        ],
        "dns": {
          "servers": [],
          "domains": []
        }
      }
    }
  ],
  "limits": {
    "max_frame_bytes": 262144,
    "max_streams": 256,
    "max_queued_bytes": 4194304,
    "max_pending_opens": 64,
    "max_rekey_jobs": 4,
    "max_control_messages": 128,
    "max_packet_bytes": 65535,
    "max_packet_batch": 64,
    "max_epoch_bytes": 4194304,
    "credit_returns_per_window": 4,
    "idle_epoch_rotation": true,
    "max_egress_mbps": 1000
  },
  "control": {
    "socket": "/run/yume/control.sock"
  },
  "cluster": {
    "operator_key": {
      "file": "cluster/operator.pub"
    },
    "list": {
      "file": "cluster/list.json"
    },
    "signature": {
      "file": "cluster/list.sig"
    },
    "peers": {
      "file": "cluster/peers.json"
    },
    "state": {
      "file": "cluster/state.json"
    },
    "routes": {
      "file": "cluster/routes.json"
    },
    "routes_signature": {
      "file": "cluster/routes.sig"
    },
    "exit": {
      "service": "tcp"
    }
  }
}
